# ===== 大模型 / RAG（通义千问 DashScope,OpenAI 兼容模式）=====
# 申请: https://dashscope.console.aliyun.com/  → API Key
# 不填则聊天走"本地关键词检索 + 模板回答"降级模式,UI 仍可演示
QWEN_API_KEY=
# 可选:聊天模型,默认 qwen-plus(也可用 qwen-turbo / qwen-max)
QWEN_CHAT_MODEL=qwen-plus
# 可选:embedding 模型,默认 text-embedding-v3
QWEN_EMBED_MODEL=text-embedding-v3

# ===== 邮件通知（Resend）=====
# 申请: https://resend.com/  → API Key
# 不填则留言只打到服务器控制台(本地开发)
RESEND_API_KEY=
# 收件人(你的邮箱)
ADMIN_EMAIL=you@example.com
# 可选:发件人(需在 Resend 验证域名),默认 onerr@resend.dev
MAIL_FROM=onerr@resend.dev

# ===== 后台登录（管理 RAG 语料 / 查看留言）=====
ADMIN_USER=admin
ADMIN_PASS=change_me_strong_password
# 用于给登录 token 签名,生产务必改成随机长字符串
AUTH_SECRET=please-change-this-to-a-long-random-string

# ===== 数据库（生产期启用,开发期用本地文件）=====
# 填了 DATABASE_URL 后,留言与向量库自动切换到 Postgres(pgvector)
# 申请: Supabase / Neon / Railway Postgres,需启用 pgvector 扩展
# DATABASE_URL=postgres://user:pass@host:5432/db

# ===== 站点基础信息（用于 SEO / 元数据）=====
NEXT_PUBLIC_SITE_NAME=张明
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
