# 复制本文件为 .env.local 后填写。 .env.local 已被 Git 忽略，切勿提交真实密钥。
# 每次修改环境变量后，请重启 `npm run dev`。

# ===== 后台登录（上线前必须设置为强凭据）=====
# 这三项留空时，代码会回退到不安全的开发默认值；请务必填写。
ADMIN_USER=
ADMIN_PASS=
# 使用至少 32 位的随机字符串，例如：openssl rand -hex 32
AUTH_SECRET=

# ===== 大模型 / RAG（可选：通义千问 DashScope）=====
# 申请地址：https://dashscope.console.aliyun.com/
# 不填时聊天仍可用，但只会走本地关键词检索与资料摘录的演示模式。
QWEN_API_KEY=
# 可选，默认分别为 qwen-plus / text-embedding-v3。
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBED_MODEL=text-embedding-v3

# ===== 留言邮件通知（可选：Resend）=====
# 同时填写 API Key 与收件邮箱才会发送邮件；否则只记录到本地/COS 并输出到服务端控制台。
RESEND_API_KEY=
ADMIN_EMAIL=
# 需为 Resend 已验证的发件人；留空时默认 onerr@resend.dev。
MAIL_FROM=

# ===== 对象存储（可选：腾讯云 COS，生产建议配置）=====
# 未配置时简历、留言、访客记录、RAG 索引写到 data/objects/，仅适用于本地开发。
# 腾讯云 COS 控制台：https://console.cloud.tencent.com/cos
# COS_ENDPOINT 示例：https://cos.ap-guangzhou.myqcloud.com
COS_ENDPOINT=
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
